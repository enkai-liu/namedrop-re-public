# OS
.DS_Store

# Local config (deploy targets, device addrs)
.env
*.local

# The SNAP card identity: PRIVATE keys for the applet in firmware/hf_namedrop_snap.h.
# Regenerate both halves together with scripts/build-snap-serverinfo.py -- the header
# holds only the public blob, this file holds the private half the AWDL leg needs.
snap-identity.json

# Extracted Apple-ID credentials -- NEVER commit these.
*.pem
*.cms
key.raw
kc_*.bin

# Android card app. SnapBlobs.java is generated per identity by build-snap-serverinfo.py,
# so a committed copy would be someone else's identity with no private half.
android/**/build/
android/**/.gradle/
android/**/local.properties
android/namedrop-card/app/src/main/java/com/namedrop/card/SnapBlobs.java

# The _asquic TLS keypair from mint-snapkey-cert.sh. Its private key IS the SNAP identity's.
scratchpad/asquic-keys/
