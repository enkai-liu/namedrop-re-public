+    def _start_solicitation(self):
+        """Advertise the AirDrop 0x05 BLE solicitation to wake idle receivers (best-effort).
+
+        Uses the RTL8852BU (built-in BT) via raw HCI, which needs root, so this is a no-op with
+        a logged warning when unprivileged, when hci0 is missing/busy, or when the `namedrop`
+        package isn't importable. Controlled by `config.ble_solicit` (default True);
+        `config.ble_hci_dev` / `config.ble_mac` override the device / advertising MAC.
+        """
+        if not getattr(self.config, "ble_solicit", True):
+            return
+        try:
+            from namedrop import ble_trigger
+        except Exception as e:  # namedrop not installed alongside opendrop
+            logger.debug(f"BLE solicitation unavailable (namedrop not importable): {e}")
+            return
+        dev = getattr(self.config, "ble_hci_dev", ble_trigger.DEFAULT_HCI_DEV)
+        mac = getattr(self.config, "ble_mac", None) or ble_trigger.random_ble_mac()
+        try:
+            ble_trigger.advertise(mac, message=ble_trigger.build_airdrop_message(), dev=dev)
+        except Exception as e:
+            logger.warning(
+                f"Could not emit AirDrop BLE solicitation ({e}). Idle iPhones may not advertise "
+                "_airdrop._tcp, so discovery can find nothing. Run under sudo with bluetoothd "
+                "stopped (`sudo systemctl stop bluetooth`), or set config.ble_solicit=False to "
+                "silence this."
+            )
+            return
+        self._solicit_dev = dev
+        logger.info(f"Emitting AirDrop BLE solicitation from {mac} on {dev} to wake receivers")
+
+    def _stop_solicitation(self):
+        if self._solicit_dev is None:
+            return
+        try:
+            from namedrop import ble_trigger
+
+            ble_trigger.stop_advertising(dev=self._solicit_dev)
+        except Exception as e:
+            logger.debug(f"Error stopping BLE solicitation: {e}")
+        finally:
+            self._solicit_dev = None
+
