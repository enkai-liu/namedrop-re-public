+# --- modern AirDrop /Upload (dvzip) encoder ---------------------------------
+# A modern Apple receiver (macOS 26 / iOS) advertises SUPPORTS_DVZIP and expects
+# the /Upload payload as `application/x-dvzip`, NOT the legacy gzipped cpio. When
+# we sent gzip-cpio, a real receiver accepted /Ask then closed the /Upload with an
+# empty reply (RemoteDisconnected). dvzip framing = a sequence of
+# [4-byte big-endian length][zlib stream] blocks whose inflated bodies concatenate
+# into a standard ODC ('070707') cpio archive. (RE'd from a real macOS /Upload,
+# namedrop-re 2026-07-09; see CLAUDE.md + scratchpad/airdrop-receive-capture.py.)
+
+
+def _odc_cpio_header(name, mode, filesize, ino, nlink=1, mtime=0,
+                     uid=501, gid=20, dev=0):
+    """One ODC ('070707') cpio header + NUL-terminated name (76 header bytes +
+    name). ODC uses no per-record padding (unlike newc). Field defaults match a
+    real macOS /Upload (dev=0, uid=501/gid=20 -- the first Mac user); an Apple
+    receiver ignores uid/gid but we mirror them to stay byte-faithful."""
+    name_b = name.encode() + b"\x00"
+    return (
+        b"070707"
+        + b"%06o" % dev
+        + b"%06o" % (ino & 0o777777)
+        + b"%06o" % mode
+        + b"%06o" % uid
+        + b"%06o" % gid
+        + b"%06o" % nlink
+        + b"%06o" % 0                    # rdev
+        + b"%011o" % mtime
+        + b"%06o" % len(name_b)
+        + b"%011o" % filesize
+        + name_b
+    )
+
+
+def _appledouble(finder_info=b"\x00" * 32):
+    """Minimal AppleDouble ('._<file>') sidecar body, as macOS emits one for a
+    file with no resource fork / no extended attributes: a 26-byte header, two
+    entry descriptors -- id 9 (Finder Info, 32 bytes) + id 2 (Resource Fork,
+    empty) -- and the 32-byte Finder Info block. (A real macOS /Upload embeds the
+    file's actual xattrs here -- quarantine, TextEncoding, Finder tags -- but those
+    are file-specific; a well-formed minimal AppleDouble is what a fresh file
+    produces and is what the receiver validates for.)"""
+    magic = b"\x00\x05\x16\x07"
+    version = b"\x00\x02\x00\x00"
+    filler = b"Mac OS X        "               # 16 bytes, exactly as macOS writes
+    hdr_len = 4 + 4 + 16 + 2 + 12 + 12          # = 50 (header + 2 descriptors)
+    e_finder = struct.pack(">III", 9, hdr_len, len(finder_info))   # Finder Info
+    e_rsrc = struct.pack(">III", 2, hdr_len + len(finder_info), 0)  # empty rsrc fork
+    return magic + version + filler + struct.pack(">H", 2) + e_finder + e_rsrc + finder_info
+
+
+def _cpio_segments(file_path):
+    """Build an ODC cpio for `file_path` and return it as the list of byte
+    segments flushed as separate dvzip blocks. Entry layout mirrors a real macOS
+    /Upload exactly: the '.' dir, the './<file>' data, its './._<file>'
+    AppleDouble sidecar, then TRAILER!!! + NUL padding to a 512-byte boundary.
+    (The AppleDouble entry -- which stock/earlier builds omitted -- is required:
+    a modern receiver rejected an archive without it, accepting /Ask then closing
+    /Upload with RemoteDisconnected. RE'd from a captured macOS /Upload,
+    namedrop-re 2026-07-08.)"""
+    with open(file_path, "rb") as f:
+        data = f.read()
+    name = os.path.basename(file_path)
+    try:
+        mtime = int(os.path.getmtime(file_path))
+    except OSError:
+        mtime = 0
+    ad = _appledouble()
+    segs = [
+        _odc_cpio_header(".", 0o040700, 0, ino=0, nlink=2, mtime=mtime),
+        _odc_cpio_header("./" + name, 0o100644, len(data), ino=1, mtime=mtime),
+        data,
+        _odc_cpio_header("./._" + name, 0o100644, len(ad), ino=2, mtime=mtime),
+        ad,
+    ]
+    trailer = _odc_cpio_header("TRAILER!!!", 0, 0, ino=3, uid=0, gid=0)
+    total = sum(len(s) for s in segs) + len(trailer)
+    segs.append(trailer + b"\x00" * ((-total) % 512))
+    return segs
+
+
+def build_dvzip(file_path):
+    """Return the `application/x-dvzip` /Upload body for `file_path`: each cpio
+    segment zlib-compressed into its own [4-byte BE length][zlib stream] block,
+    matching the block framing a real macOS sender emits."""
+    out = bytearray()
+    for seg in _cpio_segments(file_path):
+        z = zlib.compress(seg)
+        out += struct.pack(">I", len(z)) + z
+    return bytes(out)
+
