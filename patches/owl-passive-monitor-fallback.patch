+int set_monitor_mode(int ifindex) {
+	/* Prefer active monitor (card ACKs frames -> full throughput). Cards that
+	 * don't support it (ath9k_htc/AR9271) fall back to passive monitor, which
+	 * still works: the peer re-transmits un-ACKed frames up to 7x. Fine for the
+	 * small contact-card payloads NameDrop exchanges. */
+	int err = set_monitor_mode_flags(ifindex, true);
+	if (err < 0) {
+		err = set_monitor_mode_flags(ifindex, false);
+		if (err == 0)
+			log_error("Running in PASSIVE monitor mode (no HW ACK) — "
+			          "expect throughput degradation on large transfers");
+	}
+	return err;
+}
